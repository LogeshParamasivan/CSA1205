import random
from collections import deque

# --- Data Models ---
class Request:
    def __init__(self, req_id, source, dest, size, start_time):
        self.req_id = req_id
        self.source = source
        self.dest = dest
        self.size = size            # Data size (determines transfer time)
        self.start_time = start_time
        self.wait_time = 0          # Cycles spent waiting for a bus
        self.transfer_time = 0      # Cycles spent actively transferring
        self.completed = False

class ArchitectureMetrics:
    def __init__(self, name):
        self.name = name
        self.total_cycles = 0
        self.contention_count = 0
        self.total_data_transferred = 0
        self.total_latency = 0
        self.completed_requests = 0

    def print_report(self):
        avg_latency = self.total_latency / self.completed_requests if self.completed_requests else 0
        throughput = self.total_data_transferred / self.total_cycles if self.total_cycles else 0
        print(f"{self.name:<18} | {self.total_cycles:<12} | {self.contention_count:<10} | {throughput:<10.2f} | {avg_latency:<12.2f}")


# --- Simulator ---
class BusSimulator:
    def __init__(self, requests, arch_type):
        """
        arch_type can be: 'single', 'multi', 'hierarchical'
        """
        # Deep copy requests to ensure fair comparison across different runs
        self.pending_requests = deque([Request(r.req_id, r.source, r.dest, r.size, r.start_time) for r in requests])
        self.active_transfers = [] # List of dicts tracking active requests and the buses they hold
        self.arch_type = arch_type
        self.cycle = 0
        self.metrics = ArchitectureMetrics(arch_type.capitalize() + " Bus")
        
        # State configurations
        self.multi_bus_capacity = 3 # Number of parallel buses for Multi-Bus
        # For Hierarchical: Local Bus (CPU-MEM), System Bus (IO-MEM/CPU)
        self.buses = {"local": True, "system": True} 

    def run(self):
        while self.pending_requests or self.active_transfers:
            self.cycle += 1
            self.process_active_transfers()
            self.schedule_new_requests()
            
        self.metrics.total_cycles = self.cycle
        return self.metrics

    def process_active_transfers(self):
        # Process ongoing transfers
        completed_this_cycle = []
        for transfer in self.active_transfers:
            req = transfer['req']
            req.transfer_time += 1
            
            if req.transfer_time >= req.size:
                req.completed = True
                self.metrics.completed_requests += 1
                self.metrics.total_data_transferred += req.size
                self.metrics.total_latency += (req.wait_time + req.transfer_time)
                completed_this_cycle.append(transfer)
                
                # Free up hierarchical buses if applicable
                if self.arch_type == 'hierarchical':
                    for b in transfer['buses_used']:
                        self.buses[b] = True

        # Remove completed transfers from active list
        for t in completed_this_cycle:
            self.active_transfers.remove(t)

    def schedule_new_requests(self):
        # Find requests that have arrived by the current cycle
        available_requests = [r for r in self.pending_requests if r.start_time <= self.cycle]
        
        for req in available_requests:
            scheduled = False
            
            if self.arch_type == 'single':
                # Only 1 transfer allowed at a time
                if len(self.active_transfers) < 1:
                    self.active_transfers.append({'req': req, 'buses_used': []})
                    self.pending_requests.remove(req)
                    scheduled = True
                else:
                    self.metrics.contention_count += 1
                    req.wait_time += 1

            elif self.arch_type == 'multi':
                # Up to N transfers allowed at a time
                if len(self.active_transfers) < self.multi_bus_capacity:
                    self.active_transfers.append({'req': req, 'buses_used': []})
                    self.pending_requests.remove(req)
                    scheduled = True
                else:
                    self.metrics.contention_count += 1
                    req.wait_time += 1

            elif self.arch_type == 'hierarchical':
                # Determine required buses
                req_buses = []
                if (req.source == 'CPU' and req.dest == 'MEM') or (req.source == 'MEM' and req.dest == 'CPU'):
                    req_buses = ['local']
                elif (req.source == 'IO' and req.dest == 'MEM') or (req.source == 'MEM' and req.dest == 'IO'):
                    req_buses = ['system']
                else: # CPU to IO or IO to CPU needs the bridge (both buses)
                    req_buses = ['local', 'system']

                # Check if required buses are free
                if all(self.buses[b] for b in req_buses):
                    for b in req_buses:
                        self.buses[b] = False
                    self.active_transfers.append({'req': req, 'buses_used': req_buses})
                    self.pending_requests.remove(req)
                    scheduled = True
                else:
                    self.metrics.contention_count += 1
                    req.wait_time += 1

# --- Workload Generator ---
def generate_workload(num_requests):
    devices = ['CPU', 'MEM', 'IO']
    requests = []
    for i in range(num_requests):
        source = random.choice(devices)
        dest = random.choice([d for d in devices if d != source])
        size = random.randint(1, 5) # Transfer takes 1 to 5 cycles
        start_time = random.randint(1, 10) # Arrives between cycle 1 and 10
        requests.append(Request(i, source, dest, size, start_time))
    
    # Sort by arrival time
    requests.sort(key=lambda x: x.start_time)
    return requests

# --- Main Execution ---
if __name__ == "__main__":
    # Generate a uniform benchmark workload
    random.seed(42) # Seed for reproducible results
    workload = generate_workload(20)

    print("--- Generated Workload ---")
    print(f"Total Requests: {len(workload)}")
    print("Devices involved: CPU, MEM, IO\n")

    # Run simulations
    sim_single = BusSimulator(workload, 'single')
    res_single = sim_single.run()

    sim_multi = BusSimulator(workload, 'multi')
    res_multi = sim_multi.run()

    sim_hierarchical = BusSimulator(workload, 'hierarchical')
    res_hierarchical = sim_hierarchical.run()

    # Compare and Display Results
    print("-" * 75)
    print(f"{'Architecture':<18} | {'Total Cycles':<12} | {'Contention':<10} | {'Throughput':<10} | {'Avg Latency':<12}")
    print("-" * 75)
    res_single.print_report()
    res_multi.print_report()
    res_hierarchical.print_report()
    print("-" * 75)
    print("\n* Throughput = Total Data / Total Cycles")
    print("* Avg Latency = Average Cycles from request generation to completion")
