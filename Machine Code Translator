class NumberSystem:
    @staticmethod
    def convert(value, from_base, to_base):
        bases = {'bin': 2, 'oct': 8, 'dec': 10, 'hex': 16}
        decimal_val = int(str(value), bases[from_base])
        
        if to_base == 'bin':
            return bin(decimal_val)[2:]
        elif to_base == 'oct':
            return oct(decimal_val)[2:]
        elif to_base == 'hex':
            return hex(decimal_val)[2:].upper()
        return str(decimal_val)

    @staticmethod
    def arithmetic(val1, base1, val2, base2, operation, out_base):
        bases = {'bin': 2, 'oct': 8, 'dec': 10, 'hex': 16}
        dec1 = int(str(val1), bases[base1])
        dec2 = int(str(val2), bases[base2])
        
        if operation == '+':
            res = dec1 + dec2
        elif operation == '-':
            res = dec1 - dec2
        elif operation == '*':
            res = dec1 * dec2
        elif operation == '/':
            res = dec1 // dec2
            
        return NumberSystem.convert(res, 'dec', out_base)


class Assembler:
    def __init__(self):
        self.opcodes = {'ADD': '0000', 'SUB': '0001', 'MOV': '0010', 'LOAD': '0011'}
        self.inv_opcodes = {v: k for k, v in self.opcodes.items()}
        self.registers = {'R0': '00', 'R1': '01', 'R2': '10', 'R3': '11'}
        self.inv_registers = {v: k for k, v in self.registers.items()}

    def encode(self, instruction):
        parts = instruction.replace(',', ' ').split()
        opcode = parts[0].upper()
        dest = parts[1].upper()
        src = parts[2].upper()

        op_bits = self.opcodes[opcode]
        dest_bits = self.registers[dest]

        if src in self.registers:
            mode_bits = '00'
            src_bits = self.registers[src].zfill(8)
        elif src.startswith('#'):
            mode_bits = '01'
            src_bits = bin(int(src[1:]))[2:].zfill(8)
        elif src.startswith('[') and src.endswith(']'):
            mode_bits = '10'
            src_bits = bin(int(src[1:-1]))[2:].zfill(8)

        machine_code = op_bits + mode_bits + dest_bits + src_bits
        return machine_code

    def decode(self, machine_code):
        op_bits = machine_code[0:4]
        mode_bits = machine_code[4:6]
        dest_bits = machine_code[6:8]
        src_bits = machine_code[8:16]

        opcode = self.inv_opcodes[op_bits]
        dest = self.inv_registers[dest_bits]

        if mode_bits == '00':
            src = self.inv_registers[src_bits[6:8]]
        elif mode_bits == '01':
            src = f"#{int(src_bits, 2)}"
        elif mode_bits == '10':
            src = f"[{int(src_bits, 2)}]"

        return f"{opcode} {dest}, {src}"


if __name__ == "__main__":
    ns = NumberSystem()
    print("Conversions:")
    print("1010 (bin) -> dec:", ns.convert("1010", "bin", "dec"))
    print("255 (dec) -> hex:", ns.convert("255", "dec", "hex"))
    print("1F (hex) -> oct:", ns.convert("1F", "hex", "oct"))
    
    print("\nArithmetic:")
    print("A (hex) + 1010 (bin) in dec:", ns.arithmetic("A", "hex", "1010", "bin", "+", "dec"))
    print("15 (dec) * 2 (dec) in hex:", ns.arithmetic("15", "dec", "2", "dec", "*", "hex"))

    asm = Assembler()
    print("\nAssembler Encoding & Decoding:")
    
    inst1 = "MOV R1, #15"
    enc1 = asm.encode(inst1)
    print(f"Instruction: {inst1}")
    print(f"Encoded    : {enc1}")
    print(f"Decoded    : {asm.decode(enc1)}\n")
    
    inst2 = "ADD R2, R1"
    enc2 = asm.encode(inst2)
    print(f"Instruction: {inst2}")
    print(f"Encoded    : {enc2}")
    print(f"Decoded    : {asm.decode(enc2)}\n")

    inst3 = "LOAD R3, [128]"
    enc3 = asm.encode(inst3)
    print(f"Instruction: {inst3}")
    print(f"Encoded    : {enc3}")
    print(f"Decoded    : {asm.decode(enc3)}\n")
