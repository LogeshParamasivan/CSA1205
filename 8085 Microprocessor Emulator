class Simulator8086:
    def __init__(self):
        self.registers = {
            'AX': 0, 'BX': 0, 'CX': 0, 'DX': 0,
            'SI': 0, 'DI': 0
        }
        self.flags = {'ZF': 0, 'SF': 0, 'CF': 0}
        self.memory = {}

    def parse_value(self, val_str):
        if val_str.endswith('H'):
            return int(val_str[:-1], 16)
        return int(val_str)

    def get_address(self, operand):
        operand = operand.strip('[]')
        if '+' in operand:
            parts = operand.split('+')
            base = self.registers.get(parts[0].strip(), 0)
            
            offset_str = parts[1].strip()
            if offset_str in self.registers:
                offset = self.registers[offset_str]
            else:
                offset = self.parse_value(offset_str)
                
            return base + offset
        elif operand in self.registers:
            return self.registers[operand]
        else:
            return self.parse_value(operand)

    def read_val(self, operand):
        if operand in self.registers:
            return self.registers[operand]
        elif operand.startswith('[') and operand.endswith(']'):
            addr = self.get_address(operand)
            return self.memory.get(addr, 0)
        else:
            return self.parse_value(operand)

    def write_val(self, operand, value):
        value = value & 0xFFFF
        if operand in self.registers:
            self.registers[operand] = value
        elif operand.startswith('[') and operand.endswith(']'):
            addr = self.get_address(operand)
            self.memory[addr] = value
        else:
            raise ValueError("Invalid destination operand")

    def update_flags(self, result):
        self.flags['ZF'] = 1 if (result & 0xFFFF) == 0 else 0
        self.flags['SF'] = 1 if (result & 0x8000) else 0
        self.flags['CF'] = 1 if result > 0xFFFF or result < 0 else 0

    def execute(self, instruction):
        parts = instruction.replace(',', ' ').split()
        if not parts:
            return
            
        opcode = parts[0].upper()

        if opcode == 'MOV':
            dest = parts[1]
            src = parts[2]
            val = self.read_val(src)
            self.write_val(dest, val)
            
        elif opcode == 'ADD':
            dest = parts[1]
            src = parts[2]
            val1 = self.read_val(dest)
            val2 = self.read_val(src)
            res = val1 + val2
            self.write_val(dest, res)
            self.update_flags(res)
            
        elif opcode == 'SUB':
            dest = parts[1]
            src = parts[2]
            val1 = self.read_val(dest)
            val2 = self.read_val(src)
            res = val1 - val2
            self.write_val(dest, res)
            self.update_flags(res)

    def run(self, program):
        for line in program:
            self.execute(line.strip())

    def display_state(self):
        print("Registers:")
        for r, v in self.registers.items():
            print(f"{r}: {hex(v).upper().replace('X', 'x')}")
            
        print("\nFlags:")
        for f, v in self.flags.items():
            print(f"{f}: {v}")
            
        print("\nMemory:")
        if not self.memory:
            print("No memory modified.")
        for a, v in self.memory.items():
            print(f"[{hex(a).upper().replace('X', 'x')}]: {hex(v).upper().replace('X', 'x')}")
        print("-" * 30)


if __name__ == "__main__":
    sim = Simulator8086()
    
    assembly_program = [
        "MOV AX, 15H",
        "MOV BX, 10H",
        "MOV [100H], AX",
        "MOV SI, 100H",
        "MOV CX, [SI]",
        "ADD BX, CX",
        "MOV [BX+5H], BX",
        "SUB BX, 25H"
    ]
    
    sim.run(assembly_program)
    sim.display_state()
