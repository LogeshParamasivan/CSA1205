class BenchmarkRecord:
    def __init__(self, name, ic, cpi, clock_freq_hz=None, cycle_time_s=None):
        self.name = name
        self.ic = ic
        self.cpi = cpi
        
        if clock_freq_hz is not None:
            self.freq = clock_freq_hz
            self.cycle_time = 1.0 / clock_freq_hz
        elif cycle_time_s is not None:
            self.cycle_time = cycle_time_s
            self.freq = 1.0 / cycle_time_s
        else:
            raise ValueError("Must provide either clock_freq_hz or cycle_time_s")

    @property
    def execution_time(self):
        return self.ic * self.cpi * self.cycle_time

    @property
    def ipc(self):
        return 1.0 / self.cpi

    @property
    def mips(self):
        return self.freq / (self.cpi * 1_000_000)


class BenchmarkingTool:
    def __init__(self):
        self.records = []

    def add_record(self, record):
        self.records.append(record)

    def generate_report(self):
        if not self.records:
            print("No datasets provided for benchmarking.")
            return

        self.records.sort(key=lambda x: x.execution_time)
        
        baseline_time = self.records[-1].execution_time
        
        print("=" * 85)
        print(f"{'Processor / Program':<20} | {'Exec Time (s)':<15} | {'MIPS':<12} | {'IPC':<8} | {'Speedup':<10}")
        print("=" * 85)
        
        for record in self.records:
            speedup = baseline_time / record.execution_time
            print(f"{record.name:<20} | {record.execution_time:<15.4e} | {record.mips:<12.2f} | {record.ipc:<8.2f} | {speedup:<8.2f}x")
        
        print("-" * 85)
        print(f"** Baseline System (1.00x): {self.records[-1].name}")
        print(f"** Optimal System: {self.records[0].name} (Lowest Execution Time)")
        print("=" * 85)


if __name__ == "__main__":
    benchmark_tool = BenchmarkingTool()

    benchmark_tool.add_record(
        BenchmarkRecord(name="Processor A", ic=50_000_000_000, cpi=1.5, clock_freq_hz=2.5e9)
    )
    
    benchmark_tool.add_record(
        BenchmarkRecord(name="Processor B", ic=45_000_000_000, cpi=1.2, clock_freq_hz=3.0e9)
    )
    
    benchmark_tool.add_record(
        BenchmarkRecord(name="Processor C", ic=60_000_000_000, cpi=2.0, cycle_time_s=0.5e-9)
    )

    benchmark_tool.generate_report()
